rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: only owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User progress documents: only owner can read and write their syllabus progression
    match /userProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
