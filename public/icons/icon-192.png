<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <rect width="512" height="512" rx="100" fill="#0A0A0B"/>
  <rect x="16" y="16" width="480" height="480" rx="84" fill="none" stroke="#FF5A1F" stroke-width="8" opacity="0.6"/>
  <!-- Inner Matrix Grid Lines -->
  <line x1="64" y1="160" x2="448" y2="160" stroke="#232327" stroke-width="4"/>
  <line x1="64" y1="256" x2="448" y2="256" stroke="#232327" stroke-width="4"/>
  <line x1="64" y1="352" x2="448" y2="352" stroke="#232327" stroke-width="4"/>
  <line x1="160" y1="64" x2="160" y2="448" stroke="#232327" stroke-width="4"/>
  <line x1="256" y1="64" x2="256" y2="448" stroke="#232327" stroke-width="4"/>
  <line x1="352" y1="64" x2="352" y2="448" stroke="#232327" stroke-width="4"/>
  <!-- Glowing HW Monogram -->
  <text x="256" y="320" font-family="'Impact', 'Arial Black', sans-serif" font-size="200" font-weight="900" fill="#FF5A1F" text-anchor="middle" letter-spacing="-8">HW</text>
  <text x="256" y="410" font-family="'Courier New', monospace" font-size="28" font-weight="bold" fill="#ECE7DD" text-anchor="middle" letter-spacing="6">HARDWIRE</text>
</svg>